{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/feedback",
      "destination": "https://docs.google.com/forms/d/e/1FAIpQLSfyeM7Iy-1U7xpHZANxo2AjBHkH7Ulqt_QhiUdf0skGgGYPDQ/viewform?hl=en",
      "permanent": false
    },
    {
      "source": "/downloads",
      "destination": "https://drive.google.com/drive/folders/1HAvlxpDWflIAUlQ9GZliyBs-VJhPocaQ",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
